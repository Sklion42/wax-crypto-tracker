# ─── Required ─────────────────────────────────────────────────────────────────
# Bot token — Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Application ID — Discord Developer Portal > your app > General Information
DISCORD_CLIENT_ID=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Register the slash commands on a single server (instant) instead of globally
# (up to 1h to appear). Leave empty if you share the bot with several servers.
DISCORD_GUILD_ID=

# Bot language: en (default) or fr
BOT_LANG=en

# How often channel names are refreshed, in minutes.
# Discord allows 2 renames per 10 minutes per channel — values below 5 are
# clamped to 5, and 10 is the safe default.
UPDATE_INTERVAL_MINUTES=10

# CoinGecko demo API key (optional). Without one the public endpoint is used
# and may occasionally rate-limit: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# WAX RPC endpoints, comma separated. Defaults to a list of public nodes.
WAX_RPC_ENDPOINTS=

# Alcor contracts (only change these if you know why).
# WAX_SWAP_CONTRACT=swap.alcor
# WAX_ORDERBOOK_CONTRACT=alcordexmain

# Where the tracked channels are stored (default: ./data/tracked-channels.json)
DATA_FILE=
